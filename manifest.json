{
  "manifest_version": 3,
  "name": "SoundFixer",
  "author": "Raymond Hsu",
  "version": "2.1.0",
  "description": "Lets you fix annoying sound problems in YouTube videos and such. Like audio in one channel only, too quiet or too loud",
  "icons": {
    "96": "icon.png",
    "48": "icon.png"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_icon": "icon.png",
    "default_title": "SoundFixer",
    "default_popup": "popup.html",
    "theme_icons": [
      {
        "dark": "icon.png",
        "light": "icon-inv.png",
        "size": 64
      },
      {
        "dark": "icon.png",
        "light": "icon-inv.png",
        "size": 48
      },
      {
        "dark": "icon.png",
        "light": "icon-inv.png",
        "size": 32
      },
      {
        "dark": "icon.png",
        "light": "icon-inv.png",
        "size": 16
      }
    ],
    "browser_style": true
  }
}
